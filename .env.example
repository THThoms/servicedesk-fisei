# =============================================================================
# ServiceDesk UTA — plantilla ÚNICA de variables de entorno (SQL Server 2022)
#
#   Servidor nuevo (producción):  cp .env.example deploy/server/.env
#   Laboratorio local:            cp .env.example .env.mssql
#
# NUNCA commitear el archivo real (.gitignore lo excluye). NUNCA reutilizar
# las contraseñas de otro servidor: genera valores nuevos, por ejemplo:
#   openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-40
# scripts/install-server.sh --generate-secrets genera todos los secretos.
#
# Leyenda: [OBLIGATORIA] · [SERVIDOR] solo deploy/server · [LAB] solo compose.yaml
# =============================================================================

# -----------------------------------------------------------------------------
# Identidad de la instalación [SERVIDOR]
# -----------------------------------------------------------------------------
# Dominio público SIN protocolo (ej. servicedesk.ejemplo.edu.ec). [OBLIGATORIA]
PUBLIC_DOMAIN=servicedesk.example.edu.ec
# Puertos internos publicados SOLO en 127.0.0.1 (nginx del host hace de proxy).
GATEWAY_BIND_PORT=8080
FRONTEND_BIND_PORT=3000
# Propósito del servidor [SERVIDOR]: produccion (por defecto) | pruebas.
# "pruebas" permite MSSQL_PID=Developer (solo desarrollo, evaluación y pruebas).
SERVER_PURPOSE=produccion

# -----------------------------------------------------------------------------
# SQL Server 2022 — motor ÚNICO. Una instancia, 3 bases aisladas.
# -----------------------------------------------------------------------------
# Edición/licencia [OBLIGATORIA en SERVIDOR]. Valores admitidos por la imagen:
#   Express | Standard | Enterprise | EnterpriseCore | <clave de producto>
#   Developer → SOLO con SERVER_PURPOSE=pruebas (licencia de desarrollo y pruebas).
#   Evaluation → bloqueada (caduca a los 180 días).
# Cambiar de edición = cambiar este valor y recrear mssql; los microservicios no cambian.
# Ver docs/installation/CONFIGURACION_SQL_SERVER.md.
MSSQL_PID=
# Imagen fijada (por defecto 2022-CU27-GDR1 por digest). Cambiarla = actualización planificada.
# MSSQL_IMAGE=
# Límite de memoria del motor (MB). SQL Server exige ≥2048. Recomendado 2048–4096.
MSSQL_MEMORY_LIMIT_MB=2048
# Límites del contenedor (memoria por encima de MSSQL_MEMORY_LIMIT_MB; vCPU).
MSSQL_CONTAINER_MEMORY=3g
MSSQL_CPUS=2
# Contraseña de 'sa' (≥12, mayúscula, minúscula, número, símbolo). [OBLIGATORIA]
MSSQL_SA_PASSWORD=
# [LAB] puerto host de SQL Server (solo 127.0.0.1)
MSSQL_HOST_PORT=14330

AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=
TICKET_DB_NAME=ticket_db
TICKET_DB_USER=ticket_user
TICKET_DB_PASSWORD=
# Cada servicio recibe SOLO las credenciales de su base (privilegio mínimo).
# Los DATABASE_URL se construyen en el compose; no se definen aquí.

# -----------------------------------------------------------------------------
# JWT compartido por auth/catalog/ticket [OBLIGATORIA] (≥32 caracteres aleatorios)
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=8h

# -----------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) — SSO institucional
# Redirect URI a registrar en Azure para el servidor nuevo:
#   https://<PUBLIC_DOMAIN>/api/auth/microsoft/callback
# Si se dejan vacías, el SSO queda deshabilitado (ssoConfigured=false).
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
ALLOWED_DOMAIN=uta.edu.ec
# Correos que reciben rol admin en su PRIMER inicio de sesión por Microsoft.
# Vacío = nadie recibe admin automáticamente (no hay valores por defecto).
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Administrador inicial [SERVIDOR · instalación limpia]
# El instalador lo crea con el bootstrap seguro (manage-user.sh bootstrap-admin):
# contraseña TEMPORAL aleatoria, guardada solo como hash; el texto se deja en
# deploy/server/.initial-admin-secret (0600) para leerlo una vez y borrarlo, y
# el primer login obliga a cambiarla. NINGUNA contraseña va en este archivo.
# Con SSO configurado: INITIAL_ADMIN_SSO_ONLY=true crea la cuenta sin contraseña.
# -----------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=Administrador ServiceDesk
INITIAL_ADMIN_SSO_ONLY=false
# Días que se conservan las sesiones caducadas/revocadas antes de purgarlas.
SESSION_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# Mecanismos de LABORATORIO [LAB]. Con NODE_ENV=production el backend los
# IGNORA siempre (dev-login, login Microsoft simulado y cuentas demo).
# -----------------------------------------------------------------------------
AUTH_DEV_LOGIN=false
AUTH_MICROSOFT_SIMULATE=false
SEED_DEMO_USERS=false
API_GATEWAY_HOST_PORT=18080
FRONTEND_HOST_PORT=13000
VITE_API_URL_LAB=http://localhost:18080

# -----------------------------------------------------------------------------
# Notificaciones por correo (ticket-service · EmailOutbox)
#   EMAIL_SEND_MODE: log (no envía) | smtp (envía con nodemailer) | mock (tests)
# -----------------------------------------------------------------------------
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_SEND_MODE=log
SMTP_FROM=ServiceDesk UTA <no-reply@uta.edu.ec>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# Imágenes adjuntas (ticket-service)
#   local      : volumen persistente ticket-uploads (modo REAL en producción hoy).
#   cloudinary : requiere instalar el paquete `cloudinary` (hoy NO está en
#                package.json → cae a local con warning). No cambiar sin plan.
# Las imágenes se sirven SIEMPRE por GET /api/tickets/:id/attachments/:aid (JWT).
# -----------------------------------------------------------------------------
STORAGE_MODE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=servicedesk-uta

# -----------------------------------------------------------------------------
# Firebase Cloud Messaging (push Android) — credenciales SOLO en backend.
#   FCM_MODE: off | log | firebase
#   FCM_PRIVATE_KEY con "\n" literales, entre comillas.
# -----------------------------------------------------------------------------
FCM_MODE=off
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Backups [SERVIDOR] — leídos por scripts/backup-mssql.sh (systemd)
# -----------------------------------------------------------------------------
BACKUP_DIR=/var/backups/servicedesk
# Conjuntos locales completos que se conservan en el disco (los anteriores se
# rotan; el historial largo vive en el repositorio Restic externo).
BACKUP_LOCAL_KEEP=3
# Compresión de los .bak por SQL Server: auto = NO comprimir si hay Restic (Restic
# comprime y deduplica: ~5 veces menos datos diarios), comprimir si solo hay copia local.
BACKUP_SQL_COMPRESSION=auto
# Copia externa OBLIGATORIA: Restic cifrado → Backblaze B2 (S3). Su configuración
# y credenciales NO van aquí: /etc/servicedesk/backup.env (plantilla en
# deploy/backup/backup.env.example). Sin ella, el backup termina con código 3.
BACKUP_REQUIRE_OFFSITE=true
# Restore drill mensual: ephemeral (SQL Server aislado temporal, ~2 GB RAM) o instance
DRILL_MODE=ephemeral
# Alertas de fallo (opcionales): correo (requiere `mail` en el host) y/o webhook.
BACKUP_ALERT_EMAIL=
BACKUP_ALERT_WEBHOOK_URL=
