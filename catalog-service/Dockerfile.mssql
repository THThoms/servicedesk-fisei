# =============================================================================
# catalog-service - Imagen para el LABORATORIO MSSQL (Fase C). Ver auth-service.
# =============================================================================
FROM node:22.23.4-slim AS builder
WORKDIR /app

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY tsconfig.json ./
COPY prisma ./prisma
RUN cp prisma/schema.mssql.prisma prisma/schema.prisma
RUN npm install
RUN npx prisma generate

COPY src ./src
RUN npm run build

# -----------------------------------------------------------------------------
FROM node:22.23.4-slim AS runner
WORKDIR /app

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends openssl ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY tsconfig.json ./
COPY prisma ./prisma
COPY docker ./docker
RUN cp prisma/schema.mssql.prisma prisma/schema.prisma
RUN npm install --omit=dev
RUN npm install --no-save ts-node@10.9.2
RUN npx prisma generate

COPY --from=builder /app/dist ./dist
# ts-node del seed importa `../src/domain/enums`; incluimos fuentes en el runner.
COPY --from=builder /app/src ./src

RUN chmod +x /app/docker/entrypoint.mssql.sh

EXPOSE 3002
CMD ["/app/docker/entrypoint.mssql.sh"]
