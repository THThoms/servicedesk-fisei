<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Sprint 4+ · Deep-link para el callback de Microsoft SSO.
              El backend redirige a ec.uta.servicedesk://auth/success?token=…
              tras autenticar; Android despierta MainActivity con este intent y
              Capacitor emite el evento `appUrlOpen` en la SPA.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ec.uta.servicedesk"
                      android:host="auth" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- FCM: canal por defecto y color/icono para notificaciones cuando la
             app está en background (sin intervención del JS). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="servicedesk_tickets" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/colorPrimary" />
    </application>

    <!-- Permisos -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ (API 33) exige permiso explícito para notificaciones. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Vibración: canal de tickets usa patrón de vibración de alta importancia. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Wake lock: permite mostrar la notificación aunque la pantalla esté
         apagada (comportamiento estándar de FCM en Android). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
