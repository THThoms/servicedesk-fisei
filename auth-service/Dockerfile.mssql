# =============================================================================
# auth-service - Imagen para el LABORATORIO MSSQL (Fase C).
# Debian slim porque el engine Prisma para SQL Server necesita libssl3 + glibc
# (alpine causa "Schema engine error" con nuestros schemas).
# Al principio del build sustituye schema.prisma por schema.mssql.prisma para
# que `prisma generate` produzca el cliente con provider="sqlserver".
# =============================================================================
FROM node:22.23.4-slim AS builder
WORKDIR /app

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY tsconfig.json ./
COPY prisma ./prisma
# Sprint C: usamos el schema MSSQL como schema por defecto durante todo el build.
RUN cp prisma/schema.mssql.prisma prisma/schema.prisma
RUN npm install
RUN npx prisma generate

COPY src ./src
RUN npm run build

# -----------------------------------------------------------------------------
FROM node:22.23.4-slim AS runner
WORKDIR /app

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends openssl ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY tsconfig.json ./
COPY prisma ./prisma
COPY docker ./docker
RUN cp prisma/schema.mssql.prisma prisma/schema.prisma
RUN npm install --omit=dev
# Sprint C: incluir ts-node en la imagen runtime porque `prisma db seed` lo
# ejecuta y no viene por defecto en producción PG (que compila el seed antes).
RUN npm install --no-save ts-node@10.9.2
RUN npx prisma generate

COPY --from=builder /app/dist ./dist
# ts-node del seed (prisma/seed.ts) importa `../src/domain/enums`; incluimos las
# fuentes TypeScript en el runner para que resuelva el path.
COPY --from=builder /app/src ./src

RUN chmod +x /app/docker/entrypoint.mssql.sh

EXPOSE 3001
CMD ["/app/docker/entrypoint.mssql.sh"]
