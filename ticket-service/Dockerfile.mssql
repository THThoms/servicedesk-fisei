# =============================================================================
# ticket-service - Imagen para el LABORATORIO MSSQL (Fase C). Ver auth-service.
# =============================================================================
FROM node:22.23.4-slim AS builder
WORKDIR /app

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY tsconfig.json ./
COPY prisma ./prisma
RUN cp prisma/schema.mssql.prisma prisma/schema.prisma
RUN npm install
RUN npx prisma generate

COPY src ./src
RUN npm run build

# -----------------------------------------------------------------------------
FROM node:22.23.4-slim AS runner
WORKDIR /app

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends openssl ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY prisma ./prisma
COPY scripts ./scripts
COPY docker ./docker
RUN cp prisma/schema.mssql.prisma prisma/schema.prisma
RUN npm install --omit=dev
RUN npx prisma generate

COPY --from=builder /app/dist ./dist

RUN mkdir -p /app/uploads && chown -R node:node /app/uploads
RUN chmod +x /app/docker/entrypoint.mssql.sh

EXPOSE 3003
CMD ["/app/docker/entrypoint.mssql.sh"]
