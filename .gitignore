# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
**/dist/
**/build/

# Environment — TODOS los archivos .env reales quedan fuera de Git
# (.env, .env.mssql, .env.uta, deploy/server/.env, …). Solo se versiona la plantilla.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Paquetes de instalación generados por scripts/build-server-package.sh
release/

# Secretos de servicio (Firebase service account, certificados, claves)
**/*service-account*.json
**/*.pem
**/*.key
**/*.crt
**/*.pfx

# Logs
logs/
*.log
npm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Prisma
**/prisma/migrations/dev.db*

# Uploads (kept inside container; ignored locally)
**/uploads/*
!**/uploads/.gitkeep

# Test coverage
coverage/
**/coverage/

# Sprint 4+ · Android + Firebase (Capacitor)
# NUNCA commitear google-services.json (contiene identificadores del proyecto FCM).
**/google-services.json
# Artefactos de Android Studio y Gradle
**/android/.gradle/
**/android/.idea/
**/android/local.properties
**/android/build/
**/android/app/build/
**/android/**/*.iml
**/android/app/release/
**/android/app/debug/
# Assets copiados por `cap sync` — se regeneran, no versionar
**/android/app/src/main/assets/public/
**/android/app/src/main/assets/capacitor.config.json
# Keystores de release nunca deben subirse al repo
**/*.keystore
**/*.jks

# TypeScript incremental build cache (no debe versionarse)
**/tsconfig.tsbuildinfo

# Temporary
*.tmp
*.temp
.cache/

# Docker volumes (mounted)
postgres-data/

# Local backups and exported artifacts
backups/

