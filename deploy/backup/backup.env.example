# =============================================================================
# ServiceDesk UTA — configuración del backup EXTERNO cifrado (Restic → B2/S3)
#
# Copia este archivo a /etc/servicedesk/backup.env  (root:root, permisos 600):
#   sudo install -d -m 700 /etc/servicedesk
#   sudo install -m 600 deploy/backup/backup.env.example /etc/servicedesk/backup.env
#
# Va FUERA de deploy/server/.env a propósito: ese .env se respalda dentro del
# repositorio cifrado; estas credenciales y la clave Restic NO deben viajar en él.
# Nunca subas este archivo con valores a Git ni lo envíes por chat/correo.
# Guía paso a paso: docs/operations/CONFIGURACION_BACKBLAZE.md
# =============================================================================

# --- Repositorio --------------------------------------------------------------
# Opción A (recomendada): el repositorio completo.
#   Formato: s3:https://<endpoint S3 del bucket>/<bucket>/<prefijo>
#   El endpoint lo muestra Backblaze en el detalle del bucket ("Endpoint").
RESTIC_REPOSITORY=
# Opción B: se compone como s3:https://$B2_S3_ENDPOINT/$B2_BUCKET/$RESTIC_REPOSITORY_PREFIX
B2_S3_ENDPOINT=
B2_BUCKET=
RESTIC_REPOSITORY_PREFIX=servicedesk
# Región del bucket tal como la muestra B2 (forma parte del endpoint). Sin valor por defecto.
B2_REGION=

# --- Credenciales S3 (Application Key de B2 LIMITADA a este bucket) ------------
# keyID → AWS_ACCESS_KEY_ID · applicationKey → AWS_SECRET_ACCESS_KEY
# NUNCA la Master Application Key de la cuenta.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Clave de cifrado Restic (secreto DISTINTO de las credenciales S3) --------
# Archivo con la clave (600). Se genera con: scripts/backup/restic-init.sh --generate-password
# Custodia obligatoria fuera del servidor: docs/operations/CUSTODIA_CLAVE_BACKUPS.md
RESTIC_PASSWORD_FILE=/etc/servicedesk/restic.pass

# --- Ejecución -------------------------------------------------------------------
# Imagen oficial de restic, versión fijada (la misma en backup, restauración y pruebas).
RESTIC_IMAGE=restic/restic:0.18.0
# Nombre lógico ESTABLE del servidor en los snapshots (la retención agrupa por él).
RESTIC_SNAPSHOT_HOST=servicedesk-prod
RESTIC_DOCKER_NETWORK=bridge
# Porcentaje de datos que lee y descifra la revisión semanal.
RESTIC_CHECK_SUBSET=5%

# --- Retención (snapshots) -------------------------------------------------------
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12

# --- Latido externo opcional -----------------------------------------------------
# URL de un monitor externo (healthchecks.io, Uptime Kuma "push"…). Se llama al
# terminar cada backup correcto (y <url>/fail si falla): si el servidor entero
# cae, el servicio externo avisa porque deja de recibir el latido.
BACKUP_HEARTBEAT_URL=

# --- Solo laboratorio ------------------------------------------------------------
# RESTIC_CACERT=      CA propia (MinIO con TLS autofirmado). Vacío con B2.
# RESTIC_ALLOW_HTTP=  true SOLO en laboratorio; en producción se exige https.
