# ServiceDesk UTA — revisión semanal del repositorio cifrado: 'restic check'
# (estructura) + lectura y descifrado de un subconjunto aleatorio de los datos
# (RESTIC_CHECK_SUBSET, 5 % por defecto: en ~20 semanas se lee todo).
[Unit]
Description=ServiceDesk UTA - Revisión de integridad del repositorio Restic
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
OnFailure=servicedesk-alert@%n.service

[Service]
Type=oneshot
Environment=SD_DIR=__SD_DIR__
Environment=SD_BACKUP_ENV=/etc/servicedesk/backup.env
ExecStart=__SD_DIR__/scripts/backup/restic-check.sh
Nice=10
TimeoutStartSec=4h
