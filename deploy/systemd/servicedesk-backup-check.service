# ServiceDesk UTA — vigilancia cada 6 h: falla (y dispara la alerta) si el último
# conjunto local tiene más de 26 h, su SHA-256 no coincide, la última ejecución
# falló, no hay copia externa, o el repositorio externo no es accesible o no
# tiene un snapshot de menos de 26 h (restic-check.sh --quick).
[Unit]
Description=ServiceDesk UTA - Verificación de backups (antigüedad, integridad, repositorio externo)
After=docker.service network-online.target
Wants=network-online.target
OnFailure=servicedesk-alert@%n.service

[Service]
Type=oneshot
Environment=SD_DIR=__SD_DIR__
Environment=SD_BACKUP_ENV=/etc/servicedesk/backup.env
ExecStart=__SD_DIR__/scripts/operations/check-backup.sh
TimeoutStartSec=15min
